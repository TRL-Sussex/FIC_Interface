<?xml version="1.0" encoding="UTF-8"?>
<!--
  Right-click menu of the FIC Studio desktop. If the Studio is closed or
  crashes, start it again from here or from the taskbar.
-->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="FIC Studio">
    <item label="FIC Control Studio">
      <action name="Execute"><command>fic studio</command></action>
    </item>
    <item label="FIC Dev Console">
      <action name="Execute"><command>fic dev</command></action>
    </item>
    <separator/>
    <item label="Terminal">
      <action name="Execute"><command>fic terminal</command></action>
    </item>
    <item label="Files">
      <action name="Execute"><command>fic files</command></action>
    </item>
    <item label="Documentation">
      <action name="Execute"><command>fic docs</command></action>
    </item>
    <separator/>
    <menu id="client-list-combined-menu"/>
  </menu>
</openbox_menu>
