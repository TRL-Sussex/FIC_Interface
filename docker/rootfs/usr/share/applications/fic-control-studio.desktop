[Desktop Entry]
Type=Application
Name=FIC Control Studio
Comment=The full FIC Studio: control, tuning, simulation, extensions
Exec=env QT_XCB_GL_INTEGRATION=xcb_glx QTWEBENGINE_CHROMIUM_FLAGS="--no-sandbox --ignore-gpu-blocklist --disable-dev-shm-usage" fic studio --web-ui
Icon=fic-studio
Terminal=false
Categories=Science;Robotics;
Actions=Classic;

[Desktop Action Classic]
Name=Classic interface
Exec=fic studio --classic
