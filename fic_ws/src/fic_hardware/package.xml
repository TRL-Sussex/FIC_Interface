<?xml version="1.0"?>
<package format="3">
  <name>fic_hardware</name>
  <version>5.6.0</version>
  <description>FIC Hardware - ROS 2 controller node for real robots (FIC control loop and robot driver bridge)</description>

  <maintainer email="at717@sussex.ac.uk">Adnan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tinyxml2</exec_depend>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>fic_simulation</depend>
  <!-- pinocchio backs the default kinematics solver. It is OPTIONAL at build
       time (see FIC_WITH_PINOCCHIO in CMakeLists.txt); declared here so rosdep
       installs it by default. Skip via rosdep's skip-keys option. -->
  <depend>pinocchio</depend>
  <depend>urdfdom_headers</depend>
  <depend>communication</depend>
  <depend>ament_index_cpp</depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

