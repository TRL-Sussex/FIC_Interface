<mujoco model="KinovaGen3_7DOF scene with a wall">
  <!-- The default scene plus something to push against.

       The wall stands in front of the arm at roughly tool height, its face at
       x = 0.68: about 9 cm beyond the fingertips at the home pose, so there is
       room to approach it and to back away, and well inside the arm's reach so
       a Cartesian target driven *into* it leaves a steady-state error the
       controller must deal with. That is the whole
       point of the exercise: a stiff impedance mode rings against it, an
       admittance mode with the force loop settles.

       Keep it heavy and fixed (no free joint): it is scenery, not an object to
       be moved. solref/solimp are MuJoCo's defaults made a little stiffer, so
       contact is firm without the simulator needing a smaller timestep. -->
  <include file="KinovaGen3_7DOF.xml"/>

  <statistic center="0.2 0 0.4" extent=".8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wall" rgba="0.72 0.45 0.30 1" specular="0.1" shininess="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="wall" pos="0.70 0 0.45">
      <geom name="wall" type="box" size="0.02 0.35 0.35" material="wall"
            solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </body>
  </worldbody>
</mujoco>
