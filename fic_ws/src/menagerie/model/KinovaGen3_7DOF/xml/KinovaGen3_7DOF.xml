    <!-- Robotiq 85 mimic relationships: every gripper joint follows
         left_outer_knuckle. polycoef=+1 for paired knuckles / inner-knuckles,
         -1 for inner fingers (matches the standard Robotiq 85 URDF). Stiff
         solref/solimp so the constraint tracks rigidly under actuator load. -->
    <equality>
        <joint joint1="right_outer_knuckle" joint2="left_outer_knuckle" polycoef="0 1 0 0 0"
               solref="0.002 1" solimp="0.99 0.999 0.001"/>
        <joint joint1="left_inner_knuckle"  joint2="left_outer_knuckle" polycoef="0 1 0 0 0"
               solref="0.002 1" solimp="0.99 0.999 0.001"/>
        <joint joint1="right_inner_knuckle" joint2="left_outer_knuckle" polycoef="0 1 0 0 0"
               solref="0.002 1" solimp="0.99 0.999 0.001"/>
        <joint joint1="left_inner_finger"   joint2="left_outer_knuckle" polycoef="0 -1 0 0 0"
               solref="0.002 1" solimp="0.99 0.999 0.001"/>
        <joint joint1="right_inner_finger"  joint2="left_outer_knuckle" polycoef="0 -1 0 0 0"
               solref="0.002 1" solimp="0.99 0.999 0.001"/>
    </equality>

</mujoco>
