<mujoco model="KinovaGen3_7DOF">

	<compiler angle="radian"/>
	<size njmax="500" nconmax="100"/>

    <default>
        <site rgba="0.8 0.6 0.7 0.3" type="ellipsoid" group="3"/>
        <geom contype='1' conaffinity='1' condim='4'  margin="1e-3" solref=".01 1" solimp=".99 .99 .01" />
        <!-- Joint viscous damping 5 N m s/rad (was 45/44): large moves converge in about a
             second and the arm is easy to push in the admittance modes. The FIC controller adds
             its own velocity damper on top. KinovaGen3_7DOF_probe.xml (the wall scenes) keeps 45. -->
        <joint armature="0.01" damping="5.0"/>
        <default class="Gen3">
            <joint damping='5.0'/>
        </default>
        <default class="Gen3e">
            <joint damping='5.0'/>
        </default>
        <default class="GRIPPER">
            <joint damping='20.25'/>
        </default>
        <!-- Robotiq 85 working-gripper class. Joints declared on the gripper bodies pick
             up the range/damping. A positive knuckle angle closes the gripper, as on the real
             Robotiq 2F-85: 0 rad open (about 80 mm between the finger pads), 0.8 rad closed.
             Gripper geoms collide with the floor, objects and the arm (contype 2 meets their
             conaffinity 1) but not with each other (conaffinity 1 does not meet contype 2), so
             the linkage cannot interlock while closing; the two finger pads touch each other
             through the explicit pair below. KinovaGen3_7DOF_probe.xml (the wall
             scenes) keeps its gripper without contacts: only its probe touches the wall. -->
        <default class="grip">
            <joint range="0 0.8" damping="0.05" armature="0.001"/>
            <geom contype="2" conaffinity="1"/>
        </default>
    </default>

    <!-- implicitfast handles the 5 Robotiq mimic equality constraints stably; the
         original Euler integrator caused the arm to oscillate and sag once those
         constraints were added. timestep stays at 1 ms. -->
    <option timestep="0.001" integrator="implicitfast">
    	<flag contact="enable" energy="enable"/>
  	</option>
	<asset>
		<!-- Gen3 Arm Meshes -->
		<mesh name="Base_Link" file="gen3/Base_Link.stl"/>
		<mesh name="Shoulder_Link" file="gen3/Shoulder_Link.stl"/>
		<mesh name="HalfArm1_Link" file="gen3/HalfArm1_Link.stl"/>
		<mesh name="HalfArm2_Link" file="gen3/HalfArm2_Link.stl"/>
		<mesh name="ForeArm_Link" file="gen3/ForeArm_Link.stl"/>
		<mesh name="SphericalWrist1_Link" file="gen3/SphericalWrist1_Link.stl"/>
		<mesh name="SphericalWrist2_Link" file="gen3/SphericalWrist2_Link.stl"/>
		<mesh name="Bracelet_Link" file="gen3/Bracelet_Link.stl"/>
		<!-- Robotiq Hand Meshes -->
		<mesh name="robotiq_85_base_link_coarse" file="robotiq/robotiq_85_base_link_coarse.stl"/>
		<mesh name="outer_knuckle_coarse" file="robotiq/outer_knuckle_coarse.stl"/>
		<mesh name="outer_finger_coarse" file="robotiq/outer_finger_coarse.stl"/>
		<mesh name="inner_knuckle_coarse" file="robotiq/inner_knuckle_coarse.stl"/>
		<mesh name="inner_finger_coarse" file="robotiq/inner_finger_coarse.stl"/>
	</asset>

    <actuator>
        <motor forcelimited="true" forcerange="-39.0 39.0" joint="Actuator1" name="torq_j1" ctrlrange="-100 100" ctrllimited="true"/>
        <motor forcelimited="true" forcerange="-39.0 39.0" joint="Actuator2" name="torq_j2" ctrlrange="-100 100" ctrllimited="true"/>
        <motor forcelimited="true" forcerange="-39.0 39.0" joint="Actuator3" name="torq_j3" ctrlrange="-60 60" ctrllimited="true"/>
        <motor forcelimited="true" forcerange="-39.0 39.0" joint="Actuator4" name="torq_j4" ctrlrange="-60 60" ctrllimited="true"/>
        <motor forcelimited="true" forcerange="-9.0 9.0" joint="Actuator5" name="torq_j5" ctrlrange="-60 60" ctrllimited="true"/>
        <motor forcelimited="true" forcerange="-9.0 9.0" joint="Actuator6" name="torq_j6" ctrlrange="-60 60" ctrllimited="true"/>
        <motor forcelimited="true" forcerange="-9.0 9.0" joint="Actuator7" name="torq_j7" ctrlrange="-60 60" ctrllimited="true"/>
        <!-- Robotiq 85 driver. The 5 mimic joints follow this one via the equality
             constraints below. Position-controlled — drive via simulation/actuators_cmds
             with actuators_name=["gripper"] and torque=[ctrl]. ctrl is the finger opening the
             gripper bridge sends, 10 x the width in metres (0.85 = 85 mm open, 0 = closed);
             this servo turns it into the knuckle angle 0.744 - 0.9346 ctrl, the angle at which
             the pads are that far apart (gap ~ 79.6 mm - 107 mm/rad x angle, measured on this
             model): 0 rad (fully open, 78.5 mm, the knuckle's limit) from ctrl 0.80 up, the pads
             touching at 0. kp 200, kv 5 (force = kp (q_target - q) - kv qdot). -->
        <general name="gripper" joint="left_outer_knuckle" ctrlrange="0 0.85" ctrllimited="true"
                 forcerange="-10 10" forcelimited="true" gaintype="fixed" gainprm="-186.92"
                 biastype="affine" biasprm="148.8 -200 -5"/>
    </actuator>
    <!-- The simulator holds a servo at its start_ctrl_<actuator> setpoint until its first command:
         the gripper starts open (85 mm), as the real one rests. -->
    <custom>
        <numeric name="start_ctrl_gripper" data="0.85"/>
    </custom>
    <!-- Base_Link is welded to the world, so MuJoCo's parent-child filter does not
         remove its contact with Shoulder_Link: the meshes overlap by ~12 mm at the
         joint and the condim-4 (torsional) contact friction held joint 1 (base yaw)
         against several N m of command torque. The real joint has no such contact. -->
    <contact>
        <exclude body1="Base_Link" body2="Shoulder_Link"/>
        <!-- The finger pads touch each other (the gripper's own geoms do not collide otherwise). -->
        <pair geom1="left_finger_pad" geom2="right_finger_pad"/>
    </contact>
<sensor>
<!-- Add force and sensors linked to the site -->
<force name="force_sensor" site="force_torque_site"/>
<torque name="torque_sensor" site="force_torque_site"/>
</sensor>
