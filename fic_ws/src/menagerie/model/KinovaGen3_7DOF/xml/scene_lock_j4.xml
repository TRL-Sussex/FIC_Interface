<mujoco model="KinovaGen3_7DOF scene lock j4">
  <!-- scene_wall.xml with joint 4 (Actuator4) locked at
       q0 = q_home_rad[3] = -2.265437 rad by an equality constraint, so the joint-4
       FIC error equals the commanded target offset. -->
  <include file="KinovaGen3_7DOF_probe.xml"/>

  <statistic center="0.2 0 0.4" extent=".8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="wall" mocap="true" pos="0.45 0 -1.0">
      <geom name="wall_geom" type="box" size="0.15 0.15 0.005" contype="2" conaffinity="2"
            rgba="0.8 0.3 0.3 0.6" solref="0.002 1" solimp="0.95 0.99 0.001"/>
    </body>
  </worldbody>
  <!-- solref timeconst 0.004 = 2 x the stepping timestep. MuJoCo (refsafe) clamps any
       smaller timeconst to 2*opt.timestep, and mujoco_native overrides the MJCF 1 ms
       timestep with sim_dt = 0.002 s ("MJCF timestep 0.001 -> stepping at 0.002"), so a
       timeconst of 0.001 would run as 0.004 anyway. It is written explicitly here. -->
  <equality>
    <joint name="lockj4" joint1="Actuator4" polycoef="-2.265437 0 0 0 0" solref="0.004 1"/>
  </equality>
</mujoco>
