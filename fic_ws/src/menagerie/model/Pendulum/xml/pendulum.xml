<mujoco model="pendulum">

  <compiler angle="radian"/>
	<size njmax="500" nconmax="100"/>
	
	
  <include file="./common/visual.xml"/>
  <include file="./common/skybox.xml"/>
  <include file="./common/materials.xml"/>

  <option timestep="0.001">
    <flag contact="disable" energy="enable"/>
  </option>

      <option integrator="RK4" >

  	</option>
  <sensor>
  <!-- Add force and sensors linked to the site -->
  <force name="force_sensor" site="force_torque_site"/>
  <torque name="torque_sensor" site="force_torque_site"/>
  </sensor>

  <actuator>
    <motor name="torq_j1" joint="Actuator1" gear="1" ctrlrange="-39 39" ctrllimited="false"/>
    
  </actuator>

  <worldbody>
    <light name="light" pos="0 0 2"/>
    <geom name="floor" size="2 2 .2" type="plane" material="grid"/>
    <camera name="fixed" pos="0 -1.5 2" xyaxes='1 0 0 0 1 1'/>
    <body name="base_link" pos="0 0 .6">
      <joint name="Actuator1" type="hinge" axis="0 1 0" damping="0.1"/>
      <site name="force_torque_site" pos="0 0 0.5" size="0.01" rgba="1 0 0 1"/>

      <geom name="base" material="decoration" type="cylinder" fromto="0 -.03 0 0 .03 0" size="0.021" mass="0.5"/>
      <geom name="base_link" material="self" type="capsule" fromto="0 0 0 0 0 0.5" size="0.02" mass="0.5"/>
      <geom name="mass" material="effector" type="sphere" pos="0 0 0.5" size="0.05" mass="0.51"/>
    </body>
  </worldbody>

 

</mujoco>
