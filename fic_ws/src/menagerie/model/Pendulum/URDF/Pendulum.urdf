<robot name="pendulum">
  <!-- Matches xml/pendulum.xml: one hinge (Actuator1) 0.6 m above the floor, the
       pole and its mass upright at q = 0; inertia as MuJoCo computes it. -->
  <link name="world"/>

  <joint name="base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.6"/>
  </joint>

  <link name="base_link"/>

  <link name="pole">
    <inertial>
      <origin xyz="0 0 0.251656"/>
      <mass value="1.51"/>
      <inertia ixx="0.075454" iyy="0.075359" izz="0.000814" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.5"/>
      </geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0.5"/>
    </visual>
  </link>

  <joint name="Actuator1" type="revolute">
    <parent link="base_link"/>
    <child link="pole"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="39.0" velocity="10.0"/>
  </joint>

  <link name="ee_link"/>

  <joint name="ee_joint" type="fixed">
    <parent link="pole"/>
    <child link="ee_link"/>
    <origin xyz="0 0 0.5"/>
  </joint>
</robot>
