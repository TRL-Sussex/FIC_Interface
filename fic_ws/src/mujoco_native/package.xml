<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mujoco_native</name>
  <version>4.5.0</version>
  <description>FIC Studio's CPU MuJoCo simulator, built on the official mujoco Python wheel (Linux x86-64 and arm64, macOS). Publishes joint states, gravity torques, IMU, force/torque and odometry and takes ActuatorCmds; mujoco_newton is the optional GPU backend with the same topic contract.</description>
  <maintainer email="at717@sussex.ac.uk">Adnan</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>communication</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>menagerie</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
